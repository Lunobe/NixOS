cursor {
    // xcursor-theme "Minecraft-Cursor"
    xcursor-size 32
}

environment {
    // XCURSOR_THEME "Minecraft-Cursor"
    XCURSOR_SIZE "32"
}

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:caps_toggle,compose:ralt"
        }
    }

    mouse {
        accel-profile "flat"
	accel-speed -0.44
    }

    warp-mouse-to-focus
}

layout {
    gaps 16

    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
	off
    }

    border {
        on
        width 4
        urgent-color "#9b0000"
    }

    shadow {
        on
        softness 14
        spread 4
        offset x=0 y=3
    }

    struts {
        left 16
        right 0
        top 16
        bottom 40
    }
}

overview {
    zoom 0.70
}

include optional=true "~/.cache/niri-wal-theme/colors.kdl"

spawn-at-startup "waybar"
spawn-at-startup "swaync"
spawn-at-startup "swayosd-server"
spawn-at-startup "niri-layout-osd"
spawn-at-startup "miru-daemon"
spawn-at-startup "awww-daemon"
spawn-at-startup "awww-daemon" "-n" "backdrop"
spawn-at-startup "copyq" "--start-server"

layer-rule {
    match namespace="^awww-daemonbackdrop$"
    place-within-backdrop true
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

window-rule {
    draw-border-with-background false
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    match app-id=r#"^org\.telegram\.desktop$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

window-rule {
    match app-id=r#"^com\.github\.hluk\.copyq$"#
    open-floating true
}

window-rule {
    match app-id="^claude-popup$"
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 650; }
}

window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}


binds {
    // Overlay doesn't fit 1080p with every bind listed, so aliases and pairs share one row.
    Mod+Slash       hotkey-overlay-title="Показать это меню" { show-hotkey-overlay; }

    // Escape hatch: forcibly toggle the active keyboard-shortcuts-inhibitor
    // (e.g. VMware/VirtualBox/remote-desktop clients holding an X11 keyboard grab).
    // allow-inhibiting=false makes niri process this bind even while a client
    // is currently inhibiting shortcuts, so it can never hold the session hostage.
    Mod+Escape allow-inhibiting=false hotkey-overlay-title="Вкл/выкл перехват клавиш приложением" { toggle-keyboard-shortcuts-inhibit; }

    Mod+Return         repeat=false hotkey-overlay-title="Терминал (kitty)" { spawn "kitty"; }
    Mod+Shift+Return   repeat=false hotkey-overlay-title="Claude Code во всплывающем окне" { spawn-sh "kitty --class claude-popup -d ~ -o window_padding_width=16 sh -c 'claude --continue || claude'"; }
    Mod+Ctrl+Return    repeat=false hotkey-overlay-title="Запуск приложений (wofi)" { spawn-sh "pkill wofi || wofi --show drun --matching fuzzy"; }
    Super+L            repeat=false hotkey-overlay-title="Заблокировать экран" { spawn "hyprlock"; }
    Mod+Tab            repeat=false hotkey-overlay-title="Обзор окон и рабочих столов" { toggle-overview; }
    Mod+Q              repeat=false hotkey-overlay-title="Закрыть окно" { close-window; }
    Mod+B              repeat=false hotkey-overlay-title="Браузер (Firefox)" { spawn "firefox"; }
    Mod+Shift+W        repeat=false hotkey-overlay-title="Случайные обои" { spawn "waypaper" "--random"; }
    Mod+Ctrl+Shift+W   repeat=false hotkey-overlay-title="Выбор обоев (waypaper)" { spawn "waypaper"; }
    Mod+E              repeat=false hotkey-overlay-title="Файловый менеджер (Nautilus)" { spawn "nautilus"; }
    Mod+P              repeat=false hotkey-overlay-title="Микшер громкости (pavucontrol)" { spawn "pavucontrol"; }
    Mod+Ctrl+P         repeat=false hotkey-overlay-title="Следующее устройство вывода звука" { spawn "audio-sink-cycle"; }
    Mod+Ctrl+Equal     hotkey-overlay-title="Громкость +5% / −5% (Mod+Ctrl+= / −)" { spawn "swayosd-client" "--max-volume" "150" "--output-volume" "+5"; }
    Mod+Ctrl+Minus     hotkey-overlay-title=null { spawn "swayosd-client" "--max-volume" "150" "--output-volume" "-5"; }
    Mod+Ctrl+KP_Add      hotkey-overlay-title=null { spawn "swayosd-client" "--max-volume" "150" "--output-volume" "+5"; }
    Mod+Ctrl+KP_Subtract hotkey-overlay-title=null { spawn "swayosd-client" "--max-volume" "150" "--output-volume" "-5"; }
    Mod+Alt+Z          repeat=false hotkey-overlay-title="Вкл/выкл miru" { spawn "miructl" "toggle"; }
    Mod+Ctrl+V         repeat=false hotkey-overlay-title="История буфера обмена (CopyQ)" { spawn "copyq" "toggle"; }

    Mod+Left  hotkey-overlay-title="Фокус влево / вправо (Mod+Left / Right, Mod+Shift+колесо)" { focus-column-left; }
    Mod+Down  hotkey-overlay-title="Фокус вниз / вверх (Mod+Down / Up)" { focus-window-down; }
    Mod+Up    hotkey-overlay-title=null { focus-window-up; }
    Mod+Right hotkey-overlay-title=null { focus-column-right; }

    Mod+Ctrl+Left  hotkey-overlay-title="Сдвинуть колонку влево / вправо (+Left / Right, H / L, Shift+колесо)" { move-column-left; }
    Mod+Ctrl+Down  hotkey-overlay-title="Сдвинуть окно вниз / вверх (+Down / Up, J / K)" { move-window-down; }
    Mod+Ctrl+Up    hotkey-overlay-title=null { move-window-up; }
    Mod+Ctrl+Right hotkey-overlay-title=null { move-column-right; }
    Mod+Ctrl+H     hotkey-overlay-title=null { move-column-left; }
    Mod+Ctrl+J     hotkey-overlay-title=null { move-window-down; }
    Mod+Ctrl+K     hotkey-overlay-title=null { move-window-up; }
    Mod+Ctrl+L     hotkey-overlay-title=null { move-column-right; }

    Mod+Home      hotkey-overlay-title="Фокус на первую / последнюю колонку (Mod+Home / End)" { focus-column-first; }
    Mod+End       hotkey-overlay-title=null { focus-column-last; }
    Mod+Ctrl+Home hotkey-overlay-title="Колонку в начало / конец (Mod+Ctrl+Home / End)" { move-column-to-first; }
    Mod+Ctrl+End  hotkey-overlay-title=null { move-column-to-last; }

    //   When buy second monitor

    //Mod+Shift+Left  { focus-monitor-left; }
    //Mod+Shift+Down  { focus-monitor-down; }
    //Mod+Shift+Up    { focus-monitor-up; }
    //Mod+Shift+Right { focus-monitor-right; }
    //Mod+Shift+H     { focus-monitor-left; }
    //Mod+Shift+J     { focus-monitor-down; }
    //Mod+Shift+K     { focus-monitor-up; }
    //Mod+Shift+L     { focus-monitor-right; }
    //Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    //Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    //Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    //Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    //Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    //Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    //Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    //Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    Mod+Page_Down       hotkey-overlay-title="Рабочий стол ниже / выше (Page Down / Up, Mod+колесо)" { focus-workspace-down; }
    Mod+Page_Up         hotkey-overlay-title=null { focus-workspace-up; }
    Mod+Ctrl+Page_Down  hotkey-overlay-title="Колонку на стол ниже / выше (Page Down / Up, U / I, колесо)" { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up    hotkey-overlay-title=null { move-column-to-workspace-up; }
    Mod+Ctrl+U          hotkey-overlay-title=null { move-column-to-workspace-down; }
    Mod+Ctrl+I          hotkey-overlay-title=null { move-column-to-workspace-up; }
    Mod+Shift+Page_Down hotkey-overlay-title="Переместить рабочий стол вниз / вверх (Page Down / Up)" { move-workspace-down; }
    Mod+Shift+Page_Up   hotkey-overlay-title=null { move-workspace-up; }

    Mod+WheelScrollDown            hotkey-overlay-title=null { focus-workspace-down; }
    Mod+WheelScrollUp              hotkey-overlay-title=null { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown       hotkey-overlay-title=null { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp         hotkey-overlay-title=null { move-column-to-workspace-up; }
    Mod+Shift+WheelScrollDown      hotkey-overlay-title=null { focus-column-right; }
    Mod+Shift+WheelScrollUp        hotkey-overlay-title=null { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown hotkey-overlay-title=null { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   hotkey-overlay-title=null { move-column-left; }

    Mod+1 hotkey-overlay-title="Перейти на рабочий стол 1…9 (Mod+1…9)" { focus-workspace 1; }
    Mod+2 hotkey-overlay-title=null { focus-workspace 2; }
    Mod+3 hotkey-overlay-title=null { focus-workspace 3; }
    Mod+4 hotkey-overlay-title=null { focus-workspace 4; }
    Mod+5 hotkey-overlay-title=null { focus-workspace 5; }
    Mod+6 hotkey-overlay-title=null { focus-workspace 6; }
    Mod+7 hotkey-overlay-title=null { focus-workspace 7; }
    Mod+8 hotkey-overlay-title=null { focus-workspace 8; }
    Mod+9 hotkey-overlay-title=null { focus-workspace 9; }
    Mod+Ctrl+1 hotkey-overlay-title="Колонку на рабочий стол 1…9 (Mod+Ctrl+1…9)" { move-column-to-workspace 1; }
    Mod+Ctrl+2 hotkey-overlay-title=null { move-column-to-workspace 2; }
    Mod+Ctrl+3 hotkey-overlay-title=null { move-column-to-workspace 3; }
    Mod+Ctrl+4 hotkey-overlay-title=null { move-column-to-workspace 4; }
    Mod+Ctrl+5 hotkey-overlay-title=null { move-column-to-workspace 5; }
    Mod+Ctrl+6 hotkey-overlay-title=null { move-column-to-workspace 6; }
    Mod+Ctrl+7 hotkey-overlay-title=null { move-column-to-workspace 7; }
    Mod+Ctrl+8 hotkey-overlay-title=null { move-column-to-workspace 8; }
    Mod+Ctrl+9 hotkey-overlay-title=null { move-column-to-workspace 9; }

    Mod+BracketLeft  hotkey-overlay-title="Вобрать/вытолкнуть окно влево / вправо ([ / ])" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title=null { consume-or-expel-window-right; }
    Mod+Comma        hotkey-overlay-title="Вобрать окно в колонку / вытолкнуть (Mod+, / .)" { consume-window-into-column; }
    Mod+Period       hotkey-overlay-title=null { expel-window-from-column; }
    Mod+R            hotkey-overlay-title="Следующая предустановленная ширина колонки" { switch-preset-column-width; }

    Mod+Ctrl+Shift+R hotkey-overlay-title="Следующая предустановленная высота окна" { switch-preset-window-height; }
    Mod+Ctrl+R       hotkey-overlay-title="Сбросить высоту окна" { reset-window-height; }

    Mod+F       hotkey-overlay-title="Развернуть колонку" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="Полный экран" { fullscreen-window; }
    Mod+M       hotkey-overlay-title="Развернуть окно до краёв" { maximize-window-to-edges; }
    Mod+Ctrl+F  hotkey-overlay-title="Растянуть колонку на свободное место" { expand-column-to-available-width; }

    Mod+C hotkey-overlay-title="Центрировать колонку" { center-column; }

    Mod+Minus       hotkey-overlay-title=null { set-column-width "-10%"; }
    Mod+Equal       hotkey-overlay-title="Ширина колонки +10% / −10% (Mod+= / −)" { set-column-width "+10%"; }
    Mod+Shift+Minus hotkey-overlay-title=null { set-window-height "-10%"; }
    Mod+Shift+Equal hotkey-overlay-title="Высота окна +10% / −10% (Mod+Shift+= / −)" { set-window-height "+10%"; }

    Mod+V       hotkey-overlay-title="Плавающее/тайловое окно" { toggle-window-floating; }
    Mod+Shift+V hotkey-overlay-title="Фокус: плавающие ↔ тайловые" { switch-focus-between-floating-and-tiling; }

    Mod+W hotkey-overlay-title="Вкладки в колонке вкл/выкл" { toggle-column-tabbed-display; }

    Print      hotkey-overlay-title="Скриншот: область / экран / окно (PrtSc, Ctrl+, Alt+)" { screenshot; }
    Ctrl+Print hotkey-overlay-title=null { screenshot-screen; }
    Alt+Print  hotkey-overlay-title=null { screenshot-window; }

    Mod+Shift+E hotkey-overlay-title="Выйти из niri" { quit; }

    Mod+Shift+P hotkey-overlay-title="Выключить мониторы" { power-off-monitors; }
}
